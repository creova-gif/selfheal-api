# SelfHealAPI Hosted Server Configuration Template
# Copy to `.env` for local development. Never commit real `.env` secrets.

# Network & Persistence
SELFHEAL_HOST=0.0.0.0
PORT=8080
SELFHEAL_DB_PATH=/data/selfheal.db
SELFHEAL_RETENTION_DAYS=30

# Operator-Approved Pydantic Models (comma-separated module.path:ClassName)
SELFHEAL_MODELS=

# Webhook & API Authentication (use strong random secrets in production)
SELFHEAL_WEBHOOK_SECRET=replace-with-hmac-webhook-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-signing-secret
GITHUB_APP_WEBHOOK_SECRET=replace-with-github-app-webhook-secret

# Tenant Rate & Synthesis Quotas
SELFHEAL_MAX_RPM=60
SELFHEAL_MAX_LLM_CALLS=20

# Outbound Zero-PII Alerting (https:// public endpoints only)
SELFHEAL_SLACK_WEBHOOK_URL=
SELFHEAL_ALERT_WEBHOOK_URL=
SELFHEAL_ALERT_WEBHOOK_SECRET=

# Optional Zero-PII LLM Fallback
ANTHROPIC_API_KEY=
